exec
/bin/zsh -lc "swift - <<'SWIFT'
import Foundation
import PDFKit

let path = \"/Users/robin/Documents/Projects/buchhaltung/2023/auszuege/Konto_0101173915-Auszug_2023_0144.pdf\"
let outPath = \"/tmp/konto_2023_0144.txt\"

guard let doc = PDFDocument(url: URL(fileURLWithPath: path)) else {
    fputs(\"ERR: cannot open PDF\\n\", stderr)
    exit(1)
}

var chunks: [String] = []
for i in 0..<doc.pageCount {
    if let page = doc.page(at: i), let s = page.string {
        chunks.append(\"===== PAGE \\(i+1) =====\\n\\(s)\")
    }
}

let joined = chunks.joined(separator: \"\\n\")
try joined.write(toFile: outPath, atomically: true, encoding: .utf8)
print(\"WROTE \\(outPath)\")
